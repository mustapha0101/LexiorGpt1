# Variables d'environnement du dépôt — copier en `.env` et remplir.
#
#   cp .env.example .env
#
# `.env` est ignoré par git : aucune clé ne doit être committée.
# Chargement automatique par Phase1_Data_Preparation/src/lexior/env.py, à
# l'import du paquet `lexior`. Une variable déjà définie dans le shell
# reste prioritaire — utile pour un run ponctuel ou un pod.
# `LEXIOR_ENV_FILE=/chemin/vers/.env` force un autre fichier.

# ── Génération : modèle enseignant ───────────────────────────────────────
# Repli historique de TEACHER_API_KEY quand elle n'est pas définie.
OPENAI_API_KEY=
# Décommenter pour viser un serveur autre qu'OpenAI (vLLM auto-hébergé,
# passerelle interne…). Une valeur factice suffit si le serveur
# n'authentifie pas.
# TEACHER_BASE_URL=
# TEACHER_API_KEY=
# TEACHER_MODEL=

# ── Critique ─────────────────────────────────────────────────────────────
# Sans ces variables, le critic retombe sur le teacher : le même modèle
# génère et juge la trajectoire. Le run l'annonce au démarrage et
# l'inscrit au manifeste sous `critic_is_teacher`.
# CRITIC_BASE_URL=
# CRITIC_API_KEY=
# CRITIC_MODEL=

# ── Index sémantique CCQ/CPC ─────────────────────────────────────────────
# Repli sur OPENAI_API_KEY si absente.
RAG_EMBEDDING_API_KEY=
# RAG_EMBEDDING_MODEL=text-embedding-3-small

# ── Hugging Face : corpus source et publication du dataset ───────────────
HF_TOKEN=
# HF_DATASET_REPO_ID=

# ── Suivi d'entraînement (Phase 2) ───────────────────────────────────────
WANDB_API_KEY=
# WANDB_PROJECT=
# WANDB_ENTITY=

# ── Infrastructure (Phases 2 et 5) ───────────────────────────────────────
# RUNPOD_API_KEY=
# VLLM_API_KEY=

# ── Divers ───────────────────────────────────────────────────────────────
# Jeton git personnel, pour les opérations sur le dépôt distant. Aucun
# module Python ne le lit.
GIT_TOKEN=
